# Copie este archivo como .env y ajuste los valores (el .env NO se sube a Git)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=licofast
JWT_SECRET=cambie-esto-por-una-frase-larga-y-aleatoria
JWT_HORAS=8
PORT=5000
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
# Pagos QR: "simulado" (demo, sin banco) o "sas" (cuando exista el contrato del Banco Economico)
QR_MODO=simulado
QR_SECRETO=secreto-del-webhook
QR_EXPIRA_MIN=10
# Minutos antes de cancelar un pedido delivery pendiente sin atender (libera el stock)
PEDIDO_TTL_MIN=360
# Ruta de mysqldump (XAMPP en Windows)
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
